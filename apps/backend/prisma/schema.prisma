generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==============================
// ENUMS
// ==============================
enum Role {
  SUPER_ADMIN
  SEBEKA_GUBAE
  PRIEST
  CASHIER
  PROPERTY_MANAGER
  REGISTRAR
  YOUTH_COORDINATOR
  MEMBER
}

enum TransactionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum MemberStatus {
  ACTIVE
  DECEASED
  TRANSFERRED
  EXCOMMUNICATED
}

enum EmploymentType {
  FULL_TIME
  CONTRACT
  VOLUNTEER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  WIDOWED
  DIVORCED
}

// ==============================
// CORE TABLES
// ==============================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(MEMBER)
  employeeId   String?  @unique
  isActive     Boolean  @default(true)
  lastLogin    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  employee           Employee?           @relation("UserEmployee", fields: [employeeId], references: [id])
  transactions       Transaction[]       @relation("PreparedBy")
  approved           Transaction[]       @relation("ApprovedBy")
  auditLogs          AuditLog[]
  certificateRequests CertificateRequest[] @relation("ApprovedBy")

  @@map("users")
}

model Employee {
  id             String         @id @default(cuid())
  fullName       String
  christianName  String?
  jobTitle       String
  employmentType EmploymentType @default(FULL_TIME)
  hireDate       DateTime
  salary         Float?
  phone          String?
  maritalStatus  MaritalStatus?
  childrenCount  Int?
  userId         String?        @unique

  // Relations (no fields/references – defined on User)
  user            User?          @relation("UserEmployee")
  priestMembers   Member[]       @relation("Confessor")
  performedBaptisms Baptism[]    @relation("PerformedBy")
  performedMarriages Marriage[]  @relation("PerformedBy")
  requested       CertificateRequest[] @relation("RequestedBy")

  @@map("employees")
}

model Family {
  id                 String   @id @default(cuid())
  familyCode         String   @unique
  headOfHouseholdId  String   @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  head         Member       @relation("HeadOfFamily", fields: [headOfHouseholdId], references: [id])
  members      Member[]     @relation("FamilyMembers")
  transactions Transaction[]

  @@map("families")
}

model Member {
  id                 String         @id @default(cuid())
  firstName          String
  lastName           String
  christianName      String?
  gender             String
  phone              String?
  address            String?
  job                String?
  maritalStatus      MaritalStatus?
  childrenCount      Int?
  isHeadOfHousehold  Boolean        @default(false)
  familyId           String?
  confessorPriestId  String?
  memberStatus       MemberStatus   @default(ACTIVE)
  deletedAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Relations
  family         Family?          @relation("FamilyMembers", fields: [familyId], references: [id])
  confessor      Employee?        @relation("Confessor", fields: [confessorPriestId], references: [id])
  familyHead     Family?          @relation("HeadOfFamily")
  transactions   Transaction[]
  baptisms       Baptism[]        @relation("Child")
  marriagesGroom Marriage[]       @relation("Groom")
  marriagesBride Marriage[]       @relation("Bride")
  deceased       Deceased?

  @@index([familyId])
  @@index([confessorPriestId])
  @@map("members")
}

model Transaction {
  id               String            @id @default(cuid())
  type             String
  category         String
  amount           Float
  description      String?
  transactionDate  DateTime          @default(now())
  familyId         String?
  memberId         String?
  status           TransactionStatus @default(DRAFT)
  preparedById     String
  approvedById     String?
  approvedAt       DateTime?
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relations
  family     Family? @relation(fields: [familyId], references: [id])
  member     Member? @relation(fields: [memberId], references: [id])
  preparedBy User   @relation("PreparedBy", fields: [preparedById], references: [id])
  approvedBy User?  @relation("ApprovedBy", fields: [approvedById], references: [id])

  @@index([familyId])
  @@index([status])
  @@map("transactions")
}

model Baptism {
  id               String   @id @default(cuid())
  childFullName    String
  childGender      String
  birthDate        DateTime
  christianName    String?
  fatherName       String
  motherName       String
  godfatherName    String?
  godmotherName    String?
  parentPhone      String?
  baptismDate      DateTime
  performedByPriestId String
  childMemberId    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  performedBy      Employee @relation("PerformedBy", fields: [performedByPriestId], references: [id])
  childMember      Member?  @relation("Child", fields: [childMemberId], references: [id])

  @@map("baptisms")
}

model Marriage {
  id              String   @id @default(cuid())
  groomName       String
  brideName       String
  groomPhone      String?
  bridePhone      String?
  marriageDate    DateTime
  performedByPriestId String
  groomConfessorId String?
  brideConfessorId String?
  groomMemberId   String?
  brideMemberId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  performedBy      Employee @relation("PerformedBy", fields: [performedByPriestId], references: [id])
  groomMember      Member?  @relation("Groom", fields: [groomMemberId], references: [id])
  brideMember      Member?  @relation("Bride", fields: [brideMemberId], references: [id])

  @@map("marriages")
}

model Deceased {
  id               String   @id @default(cuid())
  memberId         String   @unique
  deathDate        DateTime
  burialFeePaid    Boolean  @default(false)
  familyPhone      String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  member Member @relation(fields: [memberId], references: [id])

  @@map("deceased")
}

model CertificateRequest {
  id                 String   @id @default(cuid())
  serviceType        String   // "BAPTISM" or "MARRIAGE"
  referenceId        String   // ID of the Baptism or Marriage
  requestedByPriestId String
  status             String   @default("PENDING")
  approvedById       String?
  approvedAt         DateTime?
  certificatePdfPath String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  requestedBy   Employee @relation("RequestedBy", fields: [requestedByPriestId], references: [id])
  approvedBy    User?    @relation("ApprovedBy", fields: [approvedById], references: [id])

  @@map("certificate_requests")
}

model RentalHouse {
  id            String   @id @default(cuid())
  houseNumber   String   @unique
  houseType     String
  monthlyRent   Float
  status        String   @default("VACANT")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  tenant        Tenant?  @relation("HouseTenant") // No fields/references here – foreign key is on Tenant

  @@map("rental_houses")
}

model Tenant {
  id            String   @id @default(cuid())
  fullName      String
  phone         String
  houseId       String   @unique
  rentStartDate DateTime
  rentEndDate   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  house        RentalHouse  @relation("HouseTenant", fields: [houseId], references: [id])
  rentPayments RentPayment[]

  @@map("tenants")
}

model RentPayment {
  id            String   @id @default(cuid())
  tenantId      String
  paymentPeriod String
  amount        Float
  paidDate      DateTime @default(now())
  status        String   @default("PAID")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("rent_payments")
}

model AuditLog {
  id             String   @id @default(cuid())
  tableName      String
  recordId       String
  oldValue       Json?
  newValue       Json?
  changedByUserId String
  changedAt      DateTime @default(now())

  // Relations
  changedBy User @relation(fields: [changedByUserId], references: [id])

  @@map("audit_logs")
}